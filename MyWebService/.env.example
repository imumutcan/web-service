# Bu dosyayi ".env" adiyla kopyalayip kendi degerlerini yaz:
#   cp .env.example .env

DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_NAME=mywebservice_db

# Base64 formatinda en az 32 byte'lik anahtar. Uretmek icin: openssl rand -base64 32
JWT_SECRET=change-me-with-openssl-rand-base64-32

